# 72 Ghante - copy this file to ".env" (same folder) and fill in the keys.
# Never share .env, never commit it. Every service here is free; do not add a card anywhere.

# --- LiveKit Cloud (voice transport) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Free service keys (leave blank any you do not have) ---
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DATA_GOV_API_KEY=

# --- Jev: only if you got a key WITHOUT a payment method ---
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_API_KEY=
JEV_MODEL=jev-latest

# --- Speech ---
# Multilingual mode uses Sarvam auto-detection and English translation for the claim engine.
VOICE_MULTILINGUAL=1
# Optional fixed starting language: hi-IN / en-IN / ml-IN / ta-IN. Blank uses the farmer's state.
VOICE_DEFAULT_LANGUAGE=
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
TTS_VOICE=simran
PIPER_VOICE=en_US-lessac-medium
CREDIT_SAVER=1

# --- LLM chains (model names are confirmed in Phase 0) ---
LLM_CHAIN=groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite
BROWSER_LLM_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash

# --- System One ---
S1_CHAIN_TEXT=head,llm
S1_CHAIN_REPORT=laya,llm
HEAD_ENCODER=intfloat/multilingual-e5-small
# Per-provider time limits have sensible defaults in apps/s1/main.py; override with S1_TIMEOUT_MS_HEAD / _LAYA / _LLM if needed.
LAYA_MODEL=convaiinnovations/laya-multilingual
S1_SIM_CACHE=1
# Lowest ROUTE confidence for the fast path in a call (measured in Phase 1).
FAST_PATH_MIN=0.5

# --- Filing ---
# scripted = no AI, free of limits (development). auto = browser agent first, scripted fill if it fails (the demo setting).
FILING_MODE=scripted
FILING_TIMEOUT_S=75
# Size and position of the Filer's browser window as width x height + left + top, e.g. 900x1000+1000+0.
# Blank: the right-hand 42 % of the screen.
FILER_WINDOW=
FILER_FIELD_DELAY_MS=250

# --- Data modes ---
WEATHER_MODE=replay
MANDI_MODE=fixture
EDGE_MODE=zeroshot

# --- Scenario ---
SCENARIO=sehore_hail
SIM_SPEED=180
MAX_PARALLEL_CALLS=8
HERO_FLOW=full
HERO_SIM=0

# --- Service addresses ---
ORCH_URL=http://localhost:8000
S1_URL=http://localhost:8200
FILER_URL=http://localhost:8300
PORTAL_URL=http://localhost:8090
MCP_WEATHER_URL=http://localhost:8101/mcp
MCP_REGISTRY_URL=http://localhost:8102/mcp
MCP_MANDI_URL=http://localhost:8103/mcp

# --- Optional reusable farmer link (free ngrok account) ---
# Copy the account authtoken here. Keep it private; never put it in scripts.
NGROK_AUTHTOKEN=

# --- Automatic crop-risk watch (sandbox scenario only; no key needed) ---
WEATHER_WATCH_MODE=live
WEATHER_POLL_SECONDS=300
WEATHER_COOLDOWN_SECONDS=21600
WEATHER_STARTUP_GRACE_SECONDS=45
WEATHER_GUST_KMH=50
WEATHER_RAIN_MM_H=20
WEATHER_HEAT_C=40
WEATHER_FROST_C=2
